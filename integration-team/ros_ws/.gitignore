# ==============================================================================
# ROS 2 Core Workspace Directories
# ==============================================================================
# Ignore the local build artifact and logging directories generated by colcon
build/
install/
log/

# Prevent colcon from indexing the workspace directory itself or external folders
COLCON_IGNORE
AMENT_IGNORE

# ==============================================================================
# Python Artifacts
# ==============================================================================
# Ignore compiled Python files and cache folders (common in Python nodes)
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/

# ==============================================================================
# C++ / CMake Artifacts
# ==============================================================================
# Ignore compiled binaries, object files, and local CMake user settings
*.o
*.so
*.a
CMakeLists.txt.user

# ==============================================================================
# Development IDEs and Editors
# ==============================================================================
# VS Code (Allows committing shared tasks/launch settings if desired, but ignores user local state)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# CLion / IntelliJ
.idea/

# QtCreator
qtcreator-*
*.user

# Vim / Emacs swap and backup files
*.swp
*~
.#*
